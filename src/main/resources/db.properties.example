# Sao chép thành db.properties và điền giá trị thật (không commit mật khẩu production).

# --- MySQL ---
db.url=jdbc:mysql://localhost:3306/souvenir_shop?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=

# --- URL công khai (dùng trong link reset email; để trống = suy ra từ request) ---
app.public.base.url=http://localhost:8080/App_Website_Do_Luu_Niem

# --- SMTP (Gmail: dùng App Password; hoặc SMTP nhà cung cấp) ---
mail.enabled=false
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.username=
mail.smtp.password=
mail.smtp.starttls.enable=true
mail.from.address=
mail.from.name=Souvenir Shop

# --- Đăng nhập Google (OAuth 2.0) ---
# Tạo client tại https://console.cloud.google.com/apis/credentials
# Loại: Web application. Authorized redirect URI phải khớp chính xác, ví dụ:
#   http://localhost:8080/App_Website_Do_Luu_Niem/auth/google/callback  
google.oauth.client.id=
google.oauth.client.secret=
# Để trống = tự suy ra từ app.public.base.url hoặc request
google.oauth.redirect.uri=

# --- VNPay SANDBOX (https://sandbox.vnpayment.vn/apis/vnpay-register/) ---
vnpay.enabled=false
vnpay.tmn.code=
vnpay.hash.secret=
vnpay.pay.url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
vnpay.version=2.1.0
# Để trống = tự suy ra từ app.public.base.url
vnpay.return.url=
vnpay.ipn.url=

# --- Phí vận chuyển & địa chỉ ---
# Phí ship cơ bản (đồng), miễn phí khi tạm tính (sau giảm) >= ngưỡng
shipping.base.fee=30000
shipping.free.threshold=500000
# Phụ phí vùng xa (mã tỉnh, VD 96=Cà Mau, 97=Bạc Liêu)
shipping.remote.surcharge=15000
shipping.remote.provinces=96,97

# API địa chỉ: open-api | vnappmob (có thể đổi trên form checkout)
address.api.provider=open-api

# Lưu ý VNPay IPN: URL phải public (không dùng localhost) để sandbox gọi được.
# Ví dụ dùng ngrok: vnpay.ipn.url=https://xxxx.ngrok.io/App_Website_Do_Luu_Niem/payment/vnpay/ipn
